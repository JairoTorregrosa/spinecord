{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["bun-types"]
  },
  "include": [
    "packages/protocol/**/*.ts",
    "packages/driver-ev3/**/*.ts",
    "packages/runtime/**/*.ts",
    "packages/sim-world/**/*.ts",
    "packages/sim-ev3/**/*.ts",
    "packages/driver-ev3dev/**/*.ts",
    "scripts/**/*.ts",
    "bench/**/*.ts",
    "apps/**/*.ts",
    "examples/**/*.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
