{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spinecord-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // one JSON line per call (src/log.ts): query with `wrangler tail --format json` or Workers Logs
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
  },
  "durable_objects": {
    "bindings": [{ "name": "ROBOT", "class_name": "RobotDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RobotDO"] }],
  "d1_databases": [
    // replace database_id with the output of `wrangler d1 create spinecord` before deploying (DEPLOY.md)
    {
      "binding": "DB",
      "database_name": "spinecord",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // CONTRACT §8: heartbeat every 1 s both ways
    "HB_INTERVAL_MS": "1000",
    // CONTRACT §1: 3 s without heartbeat -> robot offline / organ stale
    "HB_TIMEOUT_MS": "3000",
    // CONTRACT §1: organ gone after 30 s without heartbeat
    "ORGAN_GONE_MS": "30000",
    // CONTRACT §1: a stop is unverified after the runtime's announced stop_worst_ms + this margin -> fault
    "STOP_VERIFY_MARGIN_MS": "500",
    // a socket that does not say hello within this time is closed
    "HELLO_TIMEOUT_MS": "5000",
    // budget of a call with no bound of its own (describe, read, instant commands)
    "CALL_TIMEOUT_MS": "8000",
    // floor of the round-trip margin. A call's deadline at the runtime is its own budget (profile limits, wait/sample
    // duration) + max(this, 2 x measured round trip) + the runtime's stop_worst_ms; the relay gives up one more such
    // margin later. The runtime's own limits end a call first; these only catch a runtime that stopped answering.
    "DEADLINE_MARGIN_MS": "2000",
    // replaced at deploy time (wrangler deploy --var GIT_SHA:<sha>)
    "GIT_SHA": "dev",
  },
  // Secret (never here): PRINCIPALS. See DEPLOY.md and .dev.vars.example.
}
