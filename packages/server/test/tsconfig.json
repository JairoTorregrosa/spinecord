{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "DOM"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.test.ts", "harness.ts", "setup.ts", "../scripts/*.ts"]
}
